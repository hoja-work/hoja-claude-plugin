{
  "description": "Trebol TaskManage + Swarm builtin hooks + Hoja mode + session tracing. Every event is forwarded to the plugin's MCP server (one process per session), where the vendored Trebol code decides and the trace recorder writes one line per event. SessionStart and SessionEnd are command hooks: at launch no MCP client exists yet, and at SessionEnd the server may already be gone. Stop also carries the decision-answer delivery (HOJA-799): the mcp_tool Stop hook holds up to 120 s for an open bound decision's answer, and a background command hook (asyncRewake) wakes an idle session when the answer arrives later.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/session-start.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "SessionStart",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "source": "${source}"
            },
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "prompt": "${prompt}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "hoja:.*|tasks|setup|hoja|trace",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "UserPromptExpansion",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "command_name": "${command_name}",
              "command_args": "${command_args}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PreToolUse",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PostToolUse",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}",
              "tool_response": "${tool_response}",
              "duration_ms": "${duration_ms}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PostToolUseFailure",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_use_id": "${tool_use_id}",
              "error": "${error}",
              "duration_ms": "${duration_ms}",
              "is_interrupt": "${is_interrupt}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PostToolBatch",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "Stop",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "stop_hook_active": "${stop_hook_active}",
              "last_assistant_message": "${last_assistant_message}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 150
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/decision-wait.mjs"
            ],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "SubagentStart",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "SubagentStop",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "agent_transcript_path": "${agent_transcript_path}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PreCompact",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "trigger": "${trigger}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PostCompact",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "trigger": "${trigger}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "Notification",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "message": "${message}",
              "notification_type": "${notification_type}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "StopFailure",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "error": "${error}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:hoja:hoja",
            "tool": "__hoja_hook",
            "input": {
              "event": "PermissionDenied",
              "session_id": "${session_id}",
              "transcript_path": "${transcript_path}",
              "cwd": "${cwd}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "permission_mode": "${permission_mode}",
              "tool_name": "${tool_name}",
              "tool_use_id": "${tool_use_id}",
              "reason": "${reason}"
            },
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/trace-hook.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
